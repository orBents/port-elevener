---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const about = (await getCollection("site")).find((entry) => entry.data.type === "about");
if (!about || about.data.type !== "about") throw new Error("Perfil do site não encontrado.");
const profile = about.data;
---

<BaseLayout title={`Sobre | ${profile.artisticName}`} description={profile.shortBio}>
  <article class="max-w-2xl">
    {profile.profileImage && <img class="mb-8 aspect-square w-32 rounded-full object-cover" src={profile.profileImage} alt={`Retrato de ${profile.artisticName}`} />}
    <p class="text-sm font-medium uppercase tracking-[0.14em] text-zinc-500">{profile.professionalTitle}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{profile.artisticName}</h1>
    <p class="mt-5 text-lg text-zinc-600">{profile.shortBio}</p>
    {profile.fullBio && <div class="mt-8 whitespace-pre-line text-zinc-700">{profile.fullBio}</div>}
    {profile.specialties.length > 0 && <section class="mt-10"><h2 class="text-xl font-semibold">Especialidades</h2><ul class="mt-3 flex flex-wrap gap-2">{profile.specialties.map((specialty) => <li class="rounded-full bg-zinc-100 px-3 py-1 text-sm">{specialty}</li>)}</ul></section>}
    {profile.sections.education && profile.education.length > 0 && <section class="mt-10"><h2 class="text-xl font-semibold">Formação</h2><ul class="mt-3 space-y-3">{profile.education.map((item) => <li><strong>{item.title}</strong>{item.institution && ` · ${item.institution}`}{item.year && ` (${item.year})`}</li>)}</ul></section>}
    {profile.sections.experience && profile.experience.length > 0 && <section class="mt-10"><h2 class="text-xl font-semibold">Trajetória</h2><ul class="mt-3 space-y-4">{profile.experience.map((item) => <li><strong>{item.title}</strong>{item.organization && ` · ${item.organization}`}{item.period && ` (${item.period})`}{item.description && <p class="mt-1 text-zinc-600">{item.description}</p>}</li>)}</ul></section>}
    {profile.sections.links && profile.links.length > 0 && <section class="mt-10"><h2 class="text-xl font-semibold">Links</h2><ul class="mt-3 space-y-2">{profile.links.map((link) => <li><a class="underline" href={link.url} rel="noreferrer" target="_blank">{link.label}</a></li>)}</ul></section>}
    {profile.resume && <a class="mt-10 inline-block underline" href={profile.resume}>Baixar currículo (PDF)</a>}
  </article>
</BaseLayout>
