---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const about = (await getCollection("site")).find((entry) => entry.data.type === "about"); if (!about || about.data.type !== "about") throw new Error("Perfil do site não encontrado."); const profile = about.data;
---
<BaseLayout title={`Sobre | ${profile.artisticName}`} description={profile.shortBio} image={profile.profileImage}>
  <article class="site-shell site-section" style="max-width:var(--about-width,960px)"><header class="grid items-end gap-8 md:grid-cols-[auto_1fr]">{profile.profileImage && <img class="aspect-square w-32 object-cover sm:w-44" style="border-radius:var(--radius)" src={profile.profileImage} alt={`Retrato de ${profile.artisticName}`} />}<div><p class="site-caption text-xs font-bold uppercase tracking-[.18em]">{profile.professionalTitle}</p><h1 class="site-hero mt-4">{profile.artisticName}</h1><p class="site-copy mt-5 max-w-xl text-lg leading-relaxed">{profile.shortBio}</p></div></header>{profile.fullBio && <section class="mt-[var(--layout-section-gap)] max-w-2xl"><div class="site-copy whitespace-pre-line text-lg leading-relaxed">{profile.fullBio}</div></section>}{profile.sections.specialties && profile.specialties.length > 0 && <section class="mt-12"><h2 class="site-heading text-2xl font-semibold">Prática e competências</h2><ul class="mt-5 flex flex-wrap gap-2">{profile.specialties.map((specialty) => <li class="rounded-full px-4 py-2 text-sm" style="background:var(--color-surface);border:var(--border-width) solid var(--color-border)">{specialty}</li>)}</ul></section>}<div class="mt-[var(--layout-section-gap)] grid gap-12 md:grid-cols-2">{profile.sections.education && profile.education.length > 0 && <section><h2 class="site-heading text-2xl font-semibold">Formação</h2><ul class="mt-6 space-y-5">{profile.education.map((item) => <li><strong>{item.title}</strong><p class="site-copy mt-1 text-sm">{[item.institution,item.year].filter(Boolean).join(" · ")}</p></li>)}</ul></section>}{profile.sections.experience && profile.experience.length > 0 && <section><h2 class="site-heading text-2xl font-semibold">Trajetória</h2><ul class="mt-6 space-y-5">{profile.experience.map((item) => <li><strong>{item.title}</strong><p class="site-copy mt-1 text-sm">{[item.organization,item.period].filter(Boolean).join(" · ")}</p>{item.description && <p class="site-copy mt-2 text-sm">{item.description}</p>}</li>)}</ul></section>}</div>{profile.sections.links && profile.links.length > 0 && <section class="mt-[var(--layout-section-gap)]"><h2 class="site-heading text-2xl font-semibold">Contato</h2><ul class="mt-5 flex flex-wrap gap-3">{profile.links.map((link) => <li><a class="site-button" style="border:var(--border-width) solid var(--color-border)" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a></li>)}</ul>{profile.resume && <a class="mt-5 inline-block text-sm font-semibold underline underline-offset-4" href={profile.resume}>Baixar currículo</a>}</section>}</article>
</BaseLayout>
