---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { directContactLinks } from "../lib/contact";
import { plainText } from "../lib/content-model";

const about = (await getCollection("site")).find((entry) => entry.data.type === "about");
if (!about || about.data.type !== "about") throw new Error("Perfil do site não encontrado.");
const profile = about.data;
const profileLinks = [
  ...profile.links.map((link) => ({ label: link.label, href: link.url, external: true })),
  ...directContactLinks(profile.contacts),
].filter((link, index, all) => all.findIndex((candidate) => candidate.href === link.href) === index);
---
<BaseLayout title={`Sobre | ${profile.artisticName}`} description={profile.shortBio} image={profile.profileImage}>
  <article class="site-shell site-section site-about" style="max-width:var(--about-width,960px)">
    <header class="site-about__intro">
      {profile.profileImage && <img class="site-about__portrait" src={profile.profileImage} alt={`Retrato de ${profile.artisticName}`} />}
      <div class="site-about__identity">
        <p class="site-caption text-xs font-bold uppercase tracking-[.18em]">{profile.professionalTitle}</p>
        <h1 class="site-hero mt-4">{profile.artisticName}</h1>
        <p class="site-copy mt-5 max-w-xl">{profile.shortBio}</p>
        {profile.fullBio && <div class="site-about__bio site-copy whitespace-pre-line">{plainText(profile.fullBio)}</div>}
      </div>
    </header>

    {profile.sections.specialties && profile.specialties.length > 0 && <section class="mt-[var(--layout-section-gap)]"><h2 class="site-heading text-2xl font-semibold">Prática e competências</h2><ul class="mt-5 flex flex-wrap gap-2">{profile.specialties.map((specialty) => <li class="rounded-full px-4 py-2 text-sm" style="background:var(--color-surface);border:var(--border-width) solid var(--color-border)">{specialty}</li>)}</ul></section>}
    <div class="mt-[var(--layout-section-gap)] grid gap-12 md:grid-cols-2">
      {profile.sections.education && profile.education.length > 0 && <section><h2 class="site-heading text-2xl font-semibold">Formação</h2><ul class="mt-6 space-y-5">{profile.education.map((item) => <li><strong>{item.title}</strong><p class="site-copy mt-1 text-sm">{[item.institution,item.year].filter(Boolean).join(" · ")}</p></li>)}</ul></section>}
      {profile.sections.experience && profile.experience.length > 0 && <section><h2 class="site-heading text-2xl font-semibold">Trajetória</h2><ul class="mt-6 space-y-5">{profile.experience.map((item) => <li><strong>{item.title}</strong><p class="site-copy mt-1 text-sm">{[item.organization,item.period].filter(Boolean).join(" · ")}</p>{item.description && <p class="site-copy mt-2 text-sm">{item.description}</p>}</li>)}</ul></section>}
    </div>
    {(profile.sections.links && profileLinks.length > 0 || profile.resume) && <section class="mt-[var(--layout-section-gap)]"><h2 class="site-heading text-2xl font-semibold">Contato</h2>{profileLinks.length > 0 && <ul class="mt-5 flex flex-wrap gap-3">{profileLinks.map((link) => <li><a class="site-button" style="border:var(--border-width) solid var(--color-border)" href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>{link.label}{link.external && " ↗"}</a></li>)}</ul>}{profile.resume && <a class="mt-5 inline-block text-sm font-semibold underline underline-offset-4" href={profile.resume}>Baixar currículo</a>}</section>}
  </article>
</BaseLayout>
