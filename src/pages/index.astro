---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeSections from "../components/HomeSections.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPublishedProjects, getVisibleCategories } from "../lib/projects";
import { displayCategory, missingCategoryReferences } from "../lib/content-model";

const projects = await getPublishedProjects();
const categories = await getVisibleCategories();
const site = await getCollection("site");
const about = site.find((entry) => entry.data.type === "about");
const home = site.find((entry) => entry.data.type === "home");
const theme = site.find((entry) => entry.data.type === "theme");
if (!about || about.data.type !== "about") throw new Error("Perfil não encontrado.");
const profile = about.data;
const settings = theme?.data.type === "theme" ? theme.data : undefined;
const configuredSections = home?.data.type === "home" ? home.data.sections : [];
const categoryLabels = new Map(categories.map((category) => [category.data.slug, category.data.name]));
const columns = String(settings?.layout.columns ?? 3);
const missingCategories = missingCategoryReferences(projects, categories);
if (missingCategories.length) throw new Error(`Categorias ausentes para obras publicadas: ${missingCategories.join(", ")}. Crie ou restaure a categoria no painel.`);
---
<BaseLayout title={`${profile.artisticName} — ${profile.professionalTitle}`} description={profile.shortBio}>
  <section id="projetos" class="site-shell site-section" aria-labelledby="projects-title">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="site-caption text-xs font-bold uppercase tracking-[.17em]">Portfólio</p>
        <h1 id="projects-title" class="site-heading mt-2">Obras</h1>
      </div>
      {categories.length > 0 && <div class="flex flex-wrap gap-2" role="toolbar" aria-label="Filtrar obras por categoria"><button class="site-filter" type="button" data-filter="all" aria-pressed="true">Todas</button>{categories.map((category) => <button class="site-filter" type="button" data-filter={category.data.slug} aria-pressed="false">{category.data.name}</button>)}</div>}
    </div>
    {projects.length ? <div id="project-grid" class="site-grid mt-10" data-columns={columns}>{projects.map((project) => <ProjectCard project={project} label={displayCategory(project.data.category, categoryLabels)} />)}</div> : <div class="site-surface mt-8 p-10"><p class="site-copy">As obras publicadas aparecerão aqui.</p></div>}
    <p id="filter-empty" class="site-copy mt-8" role="status" hidden>Nenhuma obra publicada nesta categoria.</p>
  </section>

  <HomeSections sections={configuredSections} projects={projects} categories={categories} />

  <section class="site-shell pb-[var(--layout-section-gap)]" aria-label="Conheça o artista">
    <div class="border-t pt-8" style="border-color:var(--color-border)"><a class="site-copy inline-flex items-center gap-2 font-semibold underline underline-offset-4" href="/about">Conheça o artista <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>
<script>
  const controls = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>(".project-card")];
  const emptyState = document.querySelector<HTMLElement>("#filter-empty");
  const applyFilter = (filter: string) => {
    controls.forEach((control) => control.setAttribute("aria-pressed", String(control.dataset.filter === filter)));
    cards.forEach((card) => { card.hidden = filter !== "all" && card.dataset.category !== filter; });
    const visibleCards = cards.some((card) => !card.hidden);
    if (emptyState) emptyState.hidden = filter === "all" || visibleCards;
  };
  controls.forEach((control) => control.addEventListener("click", () => applyFilter(control.dataset.filter || "all")));
  const requestedCategory = new URLSearchParams(window.location.search).get("categoria");
  if (requestedCategory && controls.some((control) => control.dataset.filter === requestedCategory)) applyFilter(requestedCategory);
</script>
