---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedProjects } from "../lib/projects";

const projects = await getPublishedProjects();
const categoryLabels = {
  animation: "Animação 2D",
  storyboard: "Storyboard",
  sketchbook: "Sketchbook",
  illustration: "Ilustração",
  authorial: "Projeto autoral",
} as const;
---

<BaseLayout title="Enzo Portfolio" description="Projetos de animação, ilustração e storyboard.">
  <section aria-labelledby="page-title">
    <p class="text-sm font-medium uppercase tracking-[0.14em] text-zinc-500">POC</p>
    <h1 id="page-title" class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Projetos</h1>
    <p class="mt-4 max-w-2xl text-zinc-600">Listagem pública gerada a partir do conteúdo administrado no Decap CMS.</p>
  </section>

  <section class="mt-12" aria-labelledby="projects-title">
    <h2 id="projects-title" class="sr-only">Projetos publicados</h2>
    {
      projects.length === 0 ? (
        <p class="rounded-lg border border-dashed border-zinc-300 p-6 text-zinc-600">Ainda não há projetos publicados.</p>
      ) : (
        <ul class="grid gap-5 sm:grid-cols-2" role="list">
          {projects.map((project) => (
            <li class="rounded-xl border border-zinc-200 p-6">
              <p class="text-xs font-medium uppercase tracking-[0.12em] text-zinc-500">{categoryLabels[project.data.category]}</p>
              <h3 class="mt-3 text-xl font-semibold">{project.data.title}</h3>
              <p class="mt-2 text-zinc-600">{project.data.summary}</p>
              {project.data.featured && <p class="mt-4 text-sm font-medium">Em destaque</p>}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
