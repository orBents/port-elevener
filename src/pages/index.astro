---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPublishedProjects } from "../lib/projects";
const projects = await getPublishedProjects();
const about = (await getCollection("site")).find((entry) => entry.data.type === "about");
const theme = (await getCollection("site")).find((entry) => entry.data.type === "theme");
if (!about || about.data.type !== "about") throw new Error("Perfil não encontrado.");
const profile = about.data; const settings = theme?.data.type === "theme" ? theme.data : undefined;
const labels = { animation: "Animações", storyboard: "Storyboards", sketchbook: "Sketchbooks", illustration: "Ilustrações", authorial: "Autorais" } as const;
const featured = projects.filter((project) => project.data.featured); const grid = { "2": "md:grid-cols-2", "3": "md:grid-cols-2 lg:grid-cols-3", "4": "md:grid-cols-2 lg:grid-cols-4" }[settings?.galleryColumns ?? "2"];
---
<BaseLayout title={`${profile.artisticName} — ${profile.professionalTitle}`} description={profile.shortBio}>
  <section class="grid min-h-[62vh] items-end gap-10 pb-16 pt-8 lg:grid-cols-[1.1fr_.9fr]" aria-labelledby="hero-title">
    <div><p class="text-xs font-bold uppercase tracking-[.22em] text-violet-700">{profile.professionalTitle}</p><h1 id="hero-title" class="mt-5 max-w-3xl text-5xl font-semibold tracking-[-.06em] sm:text-7xl">{profile.artisticName}</h1><p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-600">{profile.shortBio}</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-zinc-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-violet-700" href="#projetos">Ver trabalhos</a><a class="rounded-full border border-zinc-300 px-5 py-3 text-sm font-semibold transition hover:border-zinc-950" href="/about">Sobre Enzo</a></div></div>
    <div class="overflow-hidden rounded-[2rem] bg-zinc-100">{settings?.heroImage ? <img src={settings.heroImage} alt="Imagem de destaque" class="aspect-[4/5] h-full w-full object-cover" /> : <div class="aspect-[4/5] bg-[radial-gradient(circle_at_20%_20%,#a78bfa,transparent_35%),radial-gradient(circle_at_80%_70%,#f97316,transparent_32%),#18181b]" aria-hidden="true"></div>}</div>
  </section>
  <nav class="sticky top-0 z-10 -mx-6 border-y border-zinc-200 bg-white/90 px-6 py-4 backdrop-blur" aria-label="Filtrar projetos"><div class="flex gap-5 overflow-x-auto text-sm font-medium"><a href="#projetos">Todos</a>{Object.entries(labels).slice(0,4).map(([key,label]) => <a href={`#${key}`}>{label}</a>)}</div></nav>
  {featured.length > 0 && <section class="py-16"><div class="mb-7 flex items-end justify-between"><div><p class="text-xs font-bold uppercase tracking-[.18em] text-violet-700">Seleção</p><h2 class="mt-2 text-3xl font-semibold tracking-tight">Em destaque</h2></div></div><div class={`grid gap-6 ${grid}`}>{featured.map((project) => <ProjectCard project={project} label={labels[project.data.category]} />)}</div></section>}
  <section id="projetos" class="py-12" aria-labelledby="projects-title"><h2 id="projects-title" class="text-3xl font-semibold tracking-tight">Projetos selecionados</h2>{projects.length === 0 ? <div class="mt-8 rounded-2xl border border-dashed border-zinc-300 p-10 text-zinc-600">Os próximos trabalhos aparecerão aqui. Volte em breve.</div> : <div class={`mt-8 grid gap-6 ${grid}`}>{projects.map((project) => <ProjectCard project={project} label={labels[project.data.category]} />)}</div>}</section>
</BaseLayout>
