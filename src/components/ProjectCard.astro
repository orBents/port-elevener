---
import type { Project } from "../lib/projects";
interface Props { project: Project; label: string; featured?: boolean; }
const { project, label, featured = false } = Astro.props;
---
<a href={`/projects/${project.data.slug}`} data-category={project.data.category} class="project-card group block focus-visible:outline-none">
  <article class={`overflow-hidden transition duration-300 group-hover:-translate-y-1 ${featured ? "md:grid md:grid-cols-[1.3fr_.7fr]" : ""}`}>
    <div class="overflow-hidden" style={`border-radius:var(--radius);background:var(--color-surface);border:var(--border-width) solid var(--color-border)`}>
      {project.data.cover ? <img src={project.data.cover} alt={`Capa de ${project.data.title}`} loading="lazy" class="h-auto w-full object-contain transition duration-500 group-hover:scale-[1.02]" /> : <div class="flex min-h-64 items-end p-7" style="background:linear-gradient(135deg,var(--color-accent),var(--color-button));color:var(--color-bg)"><span class="text-3xl font-semibold tracking-tight">{project.data.title}</span></div>}
    </div>
    <div class={featured ? "flex flex-col justify-end p-6" : "px-1 pb-2 pt-4"}><p class="site-caption text-xs font-bold uppercase tracking-[.14em]">{label}</p><h2 class="mt-2 text-2xl font-semibold tracking-[-.03em]" style="color:var(--color-heading)">{project.data.title}</h2><p class="site-copy mt-2 text-sm leading-relaxed">{project.data.summary}</p><span class="mt-4 inline-flex text-sm font-semibold" style="color:var(--color-link)">Ver projeto <span aria-hidden="true">→</span></span></div>
  </article>
</a>
