---
import type { Project } from "../lib/projects";
import { isSafeMediaSource } from "../lib/content-model";
interface Props { project: Project; label: string; featured?: boolean; }
const { project, label, featured = false } = Astro.props;
---
<a href={`/projects/${project.data.slug}`} data-category={project.data.category} class="project-card group block focus-visible:outline-none">
  <article class={`transition duration-300 group-hover:-translate-y-1 ${featured ? "md:grid md:grid-cols-[1.3fr_.7fr]" : ""}`}>
    <div class="project-card__media">
      {isSafeMediaSource(project.data.cover) ? <img src={project.data.cover} alt={`Capa de ${project.data.title}`} loading="lazy" class="project-card__image transition duration-500 group-hover:scale-[1.02]" /> : <div class="flex min-h-64 items-end p-7" style="background:linear-gradient(135deg,var(--color-accent),var(--color-button));color:var(--color-bg)"><span class="text-3xl font-semibold tracking-tight">{project.data.title}</span></div>}
    </div>
    <div class:list={["project-card__details", featured && "flex flex-col justify-end"]}><p class="site-caption text-xs font-bold uppercase tracking-[.14em]">{label}</p><h2 class="project-card__title">{project.data.title}</h2><p class="project-card__summary site-copy text-sm leading-relaxed">{project.data.summary}</p><span class="project-card__link">Ver projeto <span aria-hidden="true">→</span></span></div>
  </article>
</a>
