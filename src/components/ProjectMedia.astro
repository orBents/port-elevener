---
interface Props { type: "image" | "gif" | "youtube" | "vimeo"; source: string; alt?: string; caption?: string; index?: number; }
const { type, source, alt = "", caption, index = 0 } = Astro.props;
import { embedVideoUrl, isSafeMediaSource } from "../lib/content-model";
const embed = type === "image" || type === "gif" ? undefined : embedVideoUrl(type, source); const dialogId = `media-dialog-${index}`;
---
<figure class="overflow-hidden" style="border-radius:var(--radius);background:var(--color-surface)">{(type === "image" || type === "gif") ? isSafeMediaSource(source) ? <><button class="block w-full" type="button" data-open-dialog={dialogId} aria-label={`Ampliar imagem: ${alt || "obra"}`}><img src={source} alt={alt} loading="lazy" class="h-auto w-full object-contain" /></button><dialog id={dialogId} class="site-lightbox"><div class="relative p-3"><button class="absolute right-5 top-5 rounded-full px-3 py-2" style="background:var(--color-bg);border:var(--border-width) solid var(--color-border)" type="button" data-close-dialog={dialogId}>Fechar</button><img src={source} alt={alt} class="max-h-[88vh] w-full object-contain" /></div></dialog></> : <div class="site-media-fallback" role="status">Imagem indisponível. Atualize este item no painel.</div> : embed ? <iframe class="aspect-video w-full" src={embed} title={caption || "Vídeo do projeto"} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe> : <div class="site-media-fallback" role="status">Vídeo indisponível. Atualize este item no painel.</div>}{caption && <figcaption class="site-copy px-4 py-3 text-sm">{caption}</figcaption>}</figure>
<script>document.querySelectorAll<HTMLButtonElement>("[data-open-dialog]").forEach((button) => button.addEventListener("click", () => (document.getElementById(button.dataset.openDialog ?? "") as HTMLDialogElement | null)?.showModal())); document.querySelectorAll<HTMLButtonElement>("[data-close-dialog]").forEach((button) => button.addEventListener("click", () => (document.getElementById(button.dataset.closeDialog ?? "") as HTMLDialogElement | null)?.close()));</script>
