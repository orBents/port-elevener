---
import { getCollection } from "astro:content";
import "../styles/global.css";
import "../styles/design-tokens.css";
import { typographyStyle } from "../lib/design-system";
interface Props { title: string; description?: string; image?: string; }
const { title, description = "Portfólio profissional de artes visuais.", image } = Astro.props;
const site = await getCollection("site"); const entry = site.find((item) => item.data.type === "theme"); const about = site.find((item) => item.data.type === "about");
const theme = entry?.data.type === "theme" ? entry.data : undefined; const profile = about?.data.type === "about" ? about.data : undefined;
const colors = theme?.colors; const typography = theme?.typography; const layout = theme?.layout; const components = theme?.components;
const hero = typography ? typographyStyle(typography.hero) : undefined; const section = typography ? typographyStyle(typography.section) : undefined;
const tokenStyle = theme && colors && typography && layout && components && hero && section ? `--color-bg:${colors.background};--color-surface:${colors.surface};--color-text:${colors.text};--color-muted:${colors.mutedText};--color-heading:${colors.heading};--color-link:${colors.link};--color-border:${colors.border};--color-button:${colors.button};--color-accent:${colors.accent};--layout-container:${layout.container}px;--layout-gutter:${layout.gutter}px;--layout-section-gap:${layout.sectionGap}px;--layout-card-gap:${layout.cardGap}px;--radius:${components.radius}px;--border-width:${components.borderWidth}px;--shadow:${components.shadow === "strong" ? "0 20px 45px rgb(0 0 0 / .18)" : components.shadow === "none" ? "none" : "0 12px 30px rgb(24 24 27 / .10)"};--font-hero:${hero.family};--font-section:${section.family};--font-body:${typographyStyle(typography.body).family};--font-caption:${typographyStyle(typography.caption).family};--size-hero:${hero.size};--leading-hero:${hero.lineHeight};--tracking-hero:${hero.tracking};--tracking-section:${section.tracking};` : "";
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} />{image && <meta property="og:image" content={image} />}<link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title></head>
<body style={tokenStyle} class="antialiased"><header class="border-b" style="border-color:var(--color-border);background:var(--color-bg)"><nav class="site-shell flex min-h-18 items-center justify-between gap-5 py-5" aria-label="Principal"><a class="font-semibold tracking-tight" style="color:var(--color-heading)" href="/">{profile?.artisticName ?? "Enzo Portfolio"}</a><div class="flex items-center gap-5 text-sm"><a href="/#projetos">Projetos</a><a href="/about">Sobre</a>{profile?.links[0] && <a class="hidden sm:inline" href={profile.links[0].url} target="_blank" rel="noreferrer">Contato ↗</a>}</div></nav></header><main><slot /></main><footer class="site-shell border-t py-10 text-sm" style="border-color:var(--color-border);color:var(--color-muted)"><div class="flex flex-wrap items-center justify-between gap-4"><span>{theme?.footerText || profile?.professionalTitle || "Portfólio"}</span>{theme?.footerLinks.length ? <ul class="flex flex-wrap gap-4">{theme.footerLinks.map((link) => <li><a class="underline underline-offset-4" href={link.url} target="_blank" rel="noreferrer">{link.label}</a></li>)}</ul> : profile?.links.length ? <ul class="flex flex-wrap gap-4">{profile.links.map((link) => <li><a class="underline underline-offset-4" href={link.url} target="_blank" rel="noreferrer">{link.label}</a></li>)}</ul> : null}</div></footer></body></html>
